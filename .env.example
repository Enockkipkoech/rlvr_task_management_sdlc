# PostgreSQL server used by the evaluator.  The role needs CREATE DATABASE and
# CREATE ROLE.  Each rollout gets its own database + login role and never sees
# these credentials.  Dev default matches docker-compose.yml.
TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Concurrent sandboxed evaluations per process (each is CPU heavy; argon2 hashing)
TMR_MAX_PARALLEL_EVALS=4

# Verifiers environment
VF_ENV_ID=task-management-rlvr
# Tasks: 1 schema, 2 auth, 3 crud, 4 authorization, 5 validation, 6 e2e (omit task_ids for all six)
VF_ENV_ARGS={"split":"validation","random_seed":42}

# Model
MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
LORA_RANK=32
# Outputs are whole files, not a masked sentence: 512 tokens is far too small.
MAX_TOKENS=8192

# Training
LEARNING_RATE=1e-5
GROUP_SIZE=8
GROUPS_PER_BATCH=4
SMOKE_TRAIN_STEPS=5
FULL_TRAIN_STEPS=150

# Output directories
RUNS_DIR=./runs
BASELINE_LOG_DIR=./runs/baseline
SMOKE_LOG_DIR=./runs/smoke
FULL_LOG_DIR=./runs/full
POST_EVAL_LOG_DIR=./runs/post_eval

# Optional service credentials (never commit .env)
# TINKER_API_KEY=
# HF_TOKEN=
# MODEL_PATH=   # trained checkpoint for scripts/05_post_eval.sh (see README: unverified argument)
